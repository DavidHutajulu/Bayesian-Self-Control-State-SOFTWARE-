{
  "name": "tugas-penundaan-imbalan",
  "version": "1.0.0",
  "description": "Tugas Penundaan Imbalan - aplikasi eksperimen delay of gratification",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "npx --yes serve src",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": "Nama Kamu",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.tugaspenundaanimbalan",
    "productName": "Tugas Penundaan Imbalan",
    "files": ["main.js", "src/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.education" },
    "linux": { "target": ["AppImage"], "category": "Education" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
